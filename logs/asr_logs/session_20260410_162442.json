[
  {
    "client": "C1",
    "time": "2026-04-10T16:24:48.862186+00:00",
    "text": "너무 행복했거든요.",
    "translation": "I was so happy."
  },
  {
    "client": "C1",
    "time": "2026-04-10T16:24:53.974825+00:00",
    "text": "그래서 영원히 나를 옆에 있고 싶다.",
    "translation": "That's why I want to be by your side forever."
  },
  {
    "client": "C1",
    "time": "2026-04-10T16:24:57.737220+00:00",
    "text": "그런 생각도 했고요.",
    "translation": "I thought that too."
  },
  {
    "client": "C1",
    "time": "2026-04-10T16:25:04.795881+00:00",
    "text": "근데 오늘 나연이 보니까.",
    "translation": "But when I saw Nayeon today."
  },
  {
    "client": "C1",
    "time": "2026-04-10T16:25:07.174203+00:00",
    "text": "제 생각이 틀렸다는 거.",
    "translation": "That my thoughts were wrong."
  },
  {
    "client": "C1",
    "time": "2026-04-10T16:25:09.844697+00:00",
    "text": "알겠더라고요.",
    "translation": "I understand."
  },
  {
    "client": "C1",
    "time": "2026-04-10T16:25:12.508953+00:00",
    "text": "귀신과 함께하는 삶이라니.",
    "translation": "A life with ghosts."
  },
  {
    "client": "C1",
    "time": "2026-04-10T16:25:16.885254+00:00",
    "text": "나연이는 평범한 사람으로 살아갈래요.",
    "translation": "Nayeon wants to live like an ordinary person."
  },
  {
    "client": "C1",
    "time": "2026-04-10T16:25:22.663402+00:00",
    "text": "이제 다른 버킷리스트 나가야 해.",
    "translation": "Now I have to tick off another bucket list."
  },
  {
    "client": "C1",
    "time": "2026-04-10T16:25:26.172465+00:00",
    "text": "The other one.",
    "translation": "다른 하나."
  },
  {
    "client": "C1",
    "time": "2026-04-10T16:25:29.588423+00:00",
    "text": "꽃 하나만 하고.",
    "translation": "Just one flower."
  },
  {
    "client": "C1",
    "time": "2026-04-10T16:25:37.932464+00:00",
    "text": "하늘을 가리다. 정말로. 보라.",
    "translation": "cover the sky really. purple."
  }
]