      "total_time": 21.17862033843994,
      "first_token_latency": 1.22367525100708,
      "avg_processing_time": 10.898620338439942
    },
    {
      "file_id": "4350-9170-0045",
      "speaker_id": "4350",
      "audio_path": "c:\\Users\\VRSTUDIO3\\Desktop\\STiTy-main1\\LibriSpeech\\test-other\\4350\\9170\\4350-9170-0045.flac",
      "reference": "I AM EXPECTED FOR THE SAKE OF THE STATE TO MAKE THESE SACRIFICES TO RENOUNCE EVERYTHING THAT CAN BE PRECIOUS TO MAN PEACE FAMILY SECURITY AND HUMAN DIGNITY",
      "hypothesis": "I am expected for the sake of a state to make these sacrifices to renounce everything that can be precious to man, peace, family, security, and human dignity?",
