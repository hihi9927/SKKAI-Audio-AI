      "audio_path": "c:\\Users\\VRSTUDIO3\\Desktop\\STiTy-main1\\LibriSpeech\\test-other\\533\\131556\\533-131556-0007.flac",
      "reference": "UPON PERUSING THIS SHE TURNED SCARLET AND BIT HER LIP",
      "hypothesis": "Upon perusing this,",
