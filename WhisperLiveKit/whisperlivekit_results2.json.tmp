      "audio_path": "c:\\Users\\VRSTUDIO3\\Desktop\\STiTy-main1\\LibriSpeech\\test-other\\533\\1066\\533-1066-0022.flac",
      "reference": "THERE'S ONE THING SURE I'LL NOT BE SUSPECTED OF COMPLICITY",
      "hypothesis": "There's one thing sure, I'll not be suspected of complicity.",
      "duration": 5.425,
      "total_time": 20.568399906158447,
