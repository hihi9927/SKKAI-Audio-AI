      "total_time": 21.028502941131592,
      "first_token_latency": 1.07938814163208,
      "avg_processing_time": 12.888502941131591
    },
    {
      "file_id": "4350-9170-0007",
      "speaker_id": "4350",
      "audio_path": "c:\\Users\\VRSTUDIO3\\Desktop\\STiTy-main1\\LibriSpeech\\test-other\\4350\\9170\\4350-9170-0007.flac",
      "reference": "THESE BANDS OF ARMED MEN SUBMISSIVE TO A SINGLE WILL ARE WHAT CONSTITUTE THE ARMY",
      "hypothesis": "These bands of armed men, submissive to a single will, are what constitute the army.",
