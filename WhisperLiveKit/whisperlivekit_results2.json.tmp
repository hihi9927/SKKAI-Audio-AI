    {
      "file_id": "3080-5040-0024",
      "speaker_id": "3080",
      "audio_path": "c:\\Users\\VRSTUDIO3\\Desktop\\STiTy-main1\\LibriSpeech\\test-other\\3080\\5040\\3080-5040-0024.flac",
      "reference": "FOR MY LIFE I CANNOT BEAT INTO THEIR HEADS A PASSION THAT MUST BE SUBJECT TO NO DECAY AN EVEN PERFECT KINDNESS THAT MUST LAST PERPETUALLY WITHOUT THE LEAST INTERMISSION",
      "hypothesis": "For my life I cannot beat into their heads a passion that must be subject to no decay. An even perfect kindness that must last perpetually without the least intermission.",
