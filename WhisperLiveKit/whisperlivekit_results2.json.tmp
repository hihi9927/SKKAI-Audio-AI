      "audio_path": "c:\\Users\\VRSTUDIO3\\Desktop\\STiTy-main1\\LibriSpeech\\test-other\\7975\\280063\\7975-280063-0010.flac",
      "reference": "I WAS TOLD BY SOME OF OUR MEN FROM THE WESTERN BORDER OF THE STATE THAT THEY RECOGNIZED THE DARING YOUNG RIDER AS COLE YOUNGER",
      "hypothesis": "I was told by some of our men from the western border of the state that they recognized a daring young rider as Cole Younger.",
      "duration": 6.415,
      "total_time": 20.951663970947266,
      "first_token_latency": 0.9292278289794922,
      "avg_processing_time": 14.536663970947266
    },
