      "first_token_latency": 0.524362325668335,
      "avg_processing_time": 16.087649784088136
    },
    {
      "file_id": "4350-9170-0006",
      "speaker_id": "4350",
      "audio_path": "c:\\Users\\VRSTUDIO3\\Desktop\\STiTy-main1\\LibriSpeech\\test-other\\4350\\9170\\4350-9170-0006.flac",
      "reference": "THE POSSIBILITY OF APPLYING BODILY VIOLENCE TO PEOPLE IS PROVIDED ABOVE ALL BY AN ORGANIZATION OF ARMED MEN TRAINED TO ACT IN UNISON IN SUBMISSION TO ONE WILL",
      "hypothesis": "The possibility of applying bodily violence to people is provided above all by an organization of armed men trained to act in unison in submission to one will.",
