    },
    {
      "file_id": "7975-280085-0016",
      "speaker_id": "7975",
      "audio_path": "c:\\Users\\VRSTUDIO3\\Desktop\\STiTy-main1\\LibriSpeech\\test-other\\7975\\280085\\7975-280085-0016.flac",
      "reference": "SHERIFF GLISPIN OF WATONWAN COUNTY WHO WAS TAKING BOB'S PISTOL FROM HIM WAS ALSO SHOUTING TO THE FELLOW",
      "hypothesis": "Sheriff Glispin of Watermont County who was taking Bob's pistol from him was also shouting to the",
