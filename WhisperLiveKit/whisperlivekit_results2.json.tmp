      "file_id": "7975-280085-0014",
      "speaker_id": "7975",
      "audio_path": "c:\\Users\\VRSTUDIO3\\Desktop\\STiTy-main1\\LibriSpeech\\test-other\\7975\\280085\\7975-280085-0014.flac",
