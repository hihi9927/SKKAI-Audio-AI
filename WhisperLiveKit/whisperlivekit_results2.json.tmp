      "speaker_id": "7975",
      "audio_path": "c:\\Users\\VRSTUDIO3\\Desktop\\STiTy-main1\\LibriSpeech\\test-other\\7975\\280057\\7975-280057-0020.flac",
      "reference": "WHEN I WAS TAKEN PRISONER I EXPECTED TO BE SHOT WITHOUT CEREMONY",
      "hypothesis": "When I was taken prisoner,",
