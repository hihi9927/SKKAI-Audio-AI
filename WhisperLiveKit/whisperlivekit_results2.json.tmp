    {
      "file_id": "4350-9170-0000",
      "speaker_id": "4350",
      "audio_path": "c:\\Users\\VRSTUDIO3\\Desktop\\STiTy-main1\\LibriSpeech\\test-other\\4350\\9170\\4350-9170-0000.flac",
      "reference": "EDUCATED PEOPLE OF THE UPPER CLASSES ARE TRYING TO STIFLE THE EVER GROWING SENSE OF THE NECESSITY OF TRANSFORMING THE EXISTING SOCIAL ORDER",
      "hypothesis": "Educated people of the upper classes are trying to stifle the ever-growing sense of the necessity of transforming the existing social order.",
      "duration": 6.835,
      "total_time": 20.958853006362915,
      "first_token_latency": 1.3212227821350098,
      "avg_processing_time": 14.123853006362914
    },
    {
      "file_id": "4350-9170-0002",
      "speaker_id": "4350",
      "audio_path": "c:\\Users\\VRSTUDIO3\\Desktop\\STiTy-main1\\LibriSpeech\\test-other\\4350\\9170\\4350-9170-0002.flac",
      "reference": "IN THE SOCIAL CONCEPTION OF LIFE IT IS SUPPOSED THAT SINCE THE AIM OF LIFE IS FOUND IN GROUPS OF INDIVIDUALS INDIVIDUALS WILL VOLUNTARILY SACRIFICE THEIR OWN INTERESTS FOR THE INTERESTS OF THE GROUP",
      "hypothesis": "In the social conception of life, it is supposed that since the aim of life is found in groups of individuals, individuals will voluntarily sacrifice their own interests for the interests of the group.",
      "duration": 9.31,
      "total_time": 21.06913185119629,
      "first_token_latency": 0.5334539413452148,
      "avg_processing_time": 11.759131851196289
    },
    {
      "file_id": "4350-9170-0003",
      "speaker_id": "4350",
      "audio_path": "c:\\Users\\VRSTUDIO3\\Desktop\\STiTy-main1\\LibriSpeech\\test-other\\4350\\9170\\4350-9170-0003.flac",
      "reference": "THE CHAMPIONS OF THE SOCIAL CONCEPTION OF LIFE USUALLY TRY TO CONNECT THE IDEA OF AUTHORITY THAT IS OF VIOLENCE WITH THE IDEA OF MORAL INFLUENCE BUT THIS CONNECTION IS QUITE IMPOSSIBLE",
      "hypothesis": "The champions of the social conception of life usually try to connect the idea of authority, that is, of violence, with the idea of moral influence. But this connection is quite impossible.",
      "duration": 9.245,
      "total_time": 21.228450298309326,
      "first_token_latency": 1.1133067607879639,
      "avg_processing_time": 11.983450298309327
    },
    {
      "file_id": "4350-9170-0004",
      "speaker_id": "4350",
      "audio_path": "c:\\Users\\VRSTUDIO3\\Desktop\\STiTy-main1\\LibriSpeech\\test-other\\4350\\9170\\4350-9170-0004.flac",
      "reference": "THE MAN WHO IS CONTROLLED BY MORAL INFLUENCE ACTS IN ACCORDANCE WITH HIS OWN DESIRES",
      "hypothesis": "The man who is controlled by moral influence acts in accordance with his own desires.",
      "duration": 4.415,
