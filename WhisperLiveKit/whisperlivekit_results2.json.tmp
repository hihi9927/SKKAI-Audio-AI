      "hypothesis": "I in my turn feel the same desire,",
      "duration": 7.44,
      "total_time": 17.54333782196045,
      "first_token_latency": 1.0594792366027832,
      "avg_processing_time": 10.103337821960448
    },
    {
      "file_id": "4294-14317-0005",
      "speaker_id": "4294",
      "audio_path": "c:\\Users\\VRSTUDIO3\\Desktop\\STiTy-main1\\LibriSpeech\\test-other\\4294\\14317\\4294-14317-0005.flac",
      "reference": "I ASK NO FURTHER REWARD FOR MY LABOURS UP TO THIS TIME THAN THE GRACIOUS FAVOUR OF YOUR MOST ILLUSTRIOUS EXCELLENCY",
      "hypothesis": "I ask no further reward for my labours up to this time than the gracious favour of your most illustrious excellency.",
