      "audio_path": "c:\\Users\\VRSTUDIO3\\Desktop\\STiTy-main1\\LibriSpeech\\test-other\\533\\131556\\533-131556-0009.flac",
      "reference": "WILL YOU OBLIGE ME HELEN CONTINUED SHE",
      "hypothesis": "Continue de che",
